{
  "entities": {
    "Restaurant": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Restaurant",
      "type": "object",
      "description": "Represents a restaurant's global settings within the DineEasy application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Restaurant entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the restaurant."
        },
        "address": {
          "type": "string",
          "description": "Address of the restaurant."
        },
        "contactNumber": {
          "type": "string",
          "description": "Contact phone number of the restaurant."
        },
        "qrCodeColor": {
          "type": "string"
        },
        "qrCodeBackgroundColor": {
          "type": "string"
        },
        "qrCodeLogo": {
          "type": "string"
        },
        "onlineOrderPlatforms": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Branch": {
        "title": "Branch",
        "type": "object",
        "description": "Represents a single restaurant branch with its own specific settings.",
        "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "isMain": { "type": "boolean" },
            "restaurantName": { "type": "string" },
            "restaurantAddress": { "type": "string" },
            "currencySymbol": { "type": "string" },
            "currencyDecimalPlaces": { "type": "number" },
            "onlineOrderingEnabled": { "type": "boolean" },
            "deliveryFee": { "type": "number" },
            "minimumOrderValue": { "type": "number" },
            "taxes": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": { "type": "string" },
                        "name": { "type": "string" },
                        "rate": { "type": "number" }
                    },
                    "required": ["id", "name", "rate"]
                }
            },
            "invoiceSettings": {
                "type": "object",
                "properties": {
                    "useUnifiedNumbering": { "type": "boolean" },
                    "unified": { "type": "object", "properties": {"prefix": {"type": "string"}, "nextNumber": {"type": "number"}} },
                    "dineIn": { "type": "object", "properties": {"prefix": {"type": "string"}, "nextNumber": {"type": "number"}} },
                    "online": { "type": "object", "properties": {"prefix": {"type": "string"}, "nextNumber": {"type": "number"}} },
                    "takeAway": { "type": "object", "properties": {"prefix": {"type": "string"}, "nextNumber": {"type": "number"}} }
                }
            },
            "printSettings": {
                "type": "object",
                "properties": {
                    "invoicePrintSize": { "type": "string", "enum": ["a4", "thermal80mm", "custom"]},
                    "invoiceCustomWidth": { "type": "number" },
                    "kitchenTicketPrintSize": { "type": "string", "enum": ["a4", "thermal80mm", "custom"]},
                    "kitchenTicketCustomWidth": { "type": "number" }
                }
            },
            "qrCodeColor": { "type": "string" },
            "qrCodeBackgroundColor": { "type": "string" },
            "qrCodeLogo": { "type": "string" },
            "onlineOrderPlatforms": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "name", "isMain"]
    },
    "Table": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Table",
      "type": "object",
      "description": "Represents a table in the restaurant.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Table entity."
        },
        "branchId": {
            "type": "string",
            "description": "The ID of the branch this table belongs to."
        },
        "tableNumber": {
          "type": "string",
          "description": "The table number."
        },
        "qrCode": {
          "type": "string",
          "description": "The QR code associated with the table."
        },
        "isOccupied": {
          "type": "boolean",
          "description": "Whether this table is currently occupied."
        }
      },
      "required": [
        "id",
        "branchId",
        "tableNumber"
      ]
    },
    "Customer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer",
      "type": "object",
      "description": "Represents a customer who placed an order.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Customer entity."
        },
        "name": {
          "type": "string",
          "description": "Customer's name."
        },
        "phoneNumber": {
          "type": "string",
          "description": "Customer's phone number."
        },
        "branchId": {
          "type": "string",
          "description": "The ID of the branch this customer is associated with."
        },
        "crmId": {
          "type": "string",
          "description": "Identifier within the restaurant's CRM system."
        }
      },
      "required": [
        "id",
        "name",
        "phoneNumber",
        "branchId"
      ]
    },
    "Order": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Order",
      "type": "object",
      "description": "Represents an order placed by a customer.",
      "properties": {
        "branchId": {
          "type": "string",
          "description": "The ID of the branch this order belongs to."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time the order was created. Stored as a Firestore Timestamp."
        },
        "customerName": {
          "type": "string",
          "description": "The name of the customer who placed the order."
        },
        "customerPhone": {
          "type": "string",
          "description": "The phone number of the customer."
        },
        "invoiceNumber": {
          "type": "string",
          "description": "The unique invoice number for the order."
        },
        "items": {
          "type": "array",
          "description": "An array of items included in the order.",
          "items": {
            "$ref": "#/entities/OrderItem"
          }
        },
        "notes": {
          "type": "string",
          "description": "Optional notes for the entire order."
        },
        "orderType": {
          "type": "string",
          "description": "The type of order (e.g., 'Dine-in', 'Take-away')."
        },
        "paymentMethod": {
          "type": "string",
          "description": "The method of payment ('cash' or 'card').",
          "enum": [
            "cash",
            "card"
          ]
        },
        "status": {
          "type": "string",
          "description": "The current status of the order.",
          "enum": [
            "received",
            "preparing",
            "ready",
            "completed",
            "cancelled"
          ]
        },
        "subtotal": {
          "type": "number",
          "description": "The total price of all items before taxes."
        },
        "tableId": {
          "type": "string",
          "description": "Reference to the Table for dine-in orders."
        },
        "taxes": {
          "type": "array",
          "description": "An array of tax objects applied to the order.",
          "items": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "number"
              },
              "name": {
                "type": "string"
              },
              "rate": {
                "type": "number"
              }
            },
            "required": [
              "amount",
              "name",
              "rate"
            ]
          }
        },
        "total": {
          "type": "number",
          "description": "The final total price including all taxes."
        },
        "totalTaxAmount": {
          "type": "number",
          "description": "The sum of all tax amounts."
        }
      },
      "required": [
        "branchId",
        "createdAt",
        "customerName",
        "items",
        "status",
        "subtotal",
        "total"
      ]
    },
    "OrderItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "OrderItem",
      "type": "object",
      "description": "Represents a single item within an order.",
      "properties": {
        "category": {
          "type": "string",
          "description": "The category of the menu item."
        },
        "isReady": {
          "type": "boolean",
          "description": "Indicates if the kitchen has prepared this item."
        },
        "menuItemId": {
          "type": "string",
          "description": "Reference to the MenuItem."
        },
        "name": {
          "type": "string",
          "description": "The name of the menu item."
        },
        "notes": {
          "type": "string",
          "description": "Any special instructions for the order item."
        },
        "orderItemId": {
          "type": "string",
          "description": "Unique identifier for the order item within the order."
        },
        "price": {
          "type": "number",
          "description": "The price of a single unit of this item."
        },
        "quantity": {
          "type": "number",
          "description": "Quantity of the menu item in the order."
        },
        "status": {
          "type": "string",
          "description": "The status of this specific item.",
          "enum": [
            "active",
            "cancelled"
          ]
        }
      },
      "required": [
        "category",
        "isReady",
        "menuItemId",
        "name",
        "orderItemId",
        "price",
        "quantity",
        "status"
      ]
    },
    "MenuItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MenuItem",
      "type": "object",
      "description": "Represents an item on the restaurant's menu.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the MenuItem entity."
        },
        "branchId": {
          "type": "string",
          "description": "The ID of the branch this menu item belongs to."
        },
        "name": {
          "type": "string",
          "description": "Name of the menu item."
        },
        "description": {
          "type": "string",
          "description": "Description of the menu item."
        },
        "price": {
          "type": "number",
          "description": "Price of the menu item."
        },
        "category": {
          "type": "string",
          "description": "Category of the menu item (e.g., Appetizer, Main Course, Dessert)."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the image for the menu item.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "branchId",
        "name",
        "price"
      ]
    },
    "ActivityLog": {
        "title": "Activity Log",
        "type": "object",
        "description": "Records significant actions performed by users.",
        "properties": {
            "id": { "type": "string" },
            "userId": { "type": "string" },
            "username": { "type": "string" },
            "action": { "type": "string" },
            "details": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "userId", "username", "action", "timestamp"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/restaurants/{restaurantId}",
        "definition": {
          "entityName": "Restaurant",
          "schema": {
            "$ref": "#/entities/Restaurant"
          },
          "description": "Stores restaurant's global settings. There should only be one document in this collection."
        }
      },
      {
        "path": "/restaurants/{restaurantId}/branches/{branchId}",
        "definition": {
          "entityName": "Branch",
          "schema": {
            "$ref": "#/entities/Branch"
          },
          "description": "Stores branch-specific information and settings."
        }
      },
      {
        "path": "/restaurants/{restaurantId}/tables/{tableId}",
        "definition": {
          "entityName": "Table",
          "schema": {
            "$ref": "#/entities/Table"
          },
          "description": "Stores table information. Each table belongs to a branch."
        }
      },
      {
        "path": "/restaurants/{restaurantId}/customers/{customerId}",
        "definition": {
          "entityName": "Customer",
          "schema": {
            "$ref": "#/entities/Customer"
          },
          "description": "Stores customer details. Each customer is associated with a branch."
        }
      },
      {
        "path": "/restaurants/{restaurantId}/orders/{orderId}",
        "definition": {
          "entityName": "Order",
          "schema": {
            "$ref": "#/entities/Order"
          },
          "description": "Stores order information. Each order belongs to a branch."
        }
      },
      {
        "path": "/restaurants/{restaurantId}/menuItems/{menuItemId}",
        "definition": {
          "entityName": "MenuItem",
          "schema": {
            "$ref": "#/entities/MenuItem"
          },
          "description": "Stores menu items. Each menu item belongs to a branch."
        }
      },
       {
        "path": "/restaurants/{restaurantId}/activityLogs/{logId}",
        "definition": {
          "entityName": "ActivityLog",
          "schema": {
            "$ref": "#/entities/ActivityLog"
          },
          "description": "Stores a log of user activities for auditing."
        }
      }
    ]
  }
}
